  m_EditorClassIdentifier: Assembly-CSharp::AstroLab.Capacete.AlvoExploracao
  titulo: Painel solar
  descricao: "Os pain\xE9is fazem parte da gera\xE7\xE3o de energia da base. Observe o estado da estrutura antes de planejar a manuten\xE7\xE3o."
  charada: "Recebo luz, mas n\xE3o ilumino. Meu trabalho ajuda a manter os sistemas da base ligados. Qual \xE9 a minha fun\xE7\xE3o?"
  categoria: "EXPLORA\xC7\xC3O / SISTEMAS DA BASE"
  aoInspecionar:
    m_PersistentCalls:
      m_Calls: []
